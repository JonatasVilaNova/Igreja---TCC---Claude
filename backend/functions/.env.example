# Exemplo de variáveis de ambiente para desenvolvimento / deploy
# Renomeie para .env e preencha os valores locais, ou configure via console do provedor

# Conexão Azure SQL
DB_USER=seu_usuario_db
DB_PASSWORD=sua_senha_db
DB_SERVER=seu_servidor.database.windows.net
DB_NAME=nome_do_banco

# JWT
JWT_SECRET=uma_chave_secreta_segura

# Ambiente
NODE_ENV=development
